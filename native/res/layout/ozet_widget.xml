<?xml version="1.0" encoding="utf-8"?>
<!-- Kerteriz özet widget'ı: solda üç halka, sağda günün ham sayıları,
     altta türetilmiş skorlar. Beyaz zemin, iki kademeli mürekkep. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ozet_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/su_widget_zemin"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ozet_halka"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/ozet_halka_aciklama"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="9sp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/kerteriz_halka_dis"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/ozet_adim"
                    android:textSize="12sp"
                    android:textColor="@color/kerteriz_ink2"/>
                <TextView
                    android:id="@+id/ozet_adim_deger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="13sp"
                    android:textColor="@color/kerteriz_ink"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="9sp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/kerteriz_halka_orta"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/ozet_kalori"
                    android:textSize="12sp"
                    android:textColor="@color/kerteriz_ink2"/>
                <TextView
                    android:id="@+id/ozet_kalori_deger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="13sp"
                    android:textColor="@color/kerteriz_ink"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="9sp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/kerteriz_halka_ic"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/ozet_mesafe"
                    android:textSize="12sp"
                    android:textColor="@color/kerteriz_ink2"/>
                <TextView
                    android:id="@+id/ozet_mesafe_deger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="13sp"
                    android:textColor="@color/kerteriz_ink"/>
            </LinearLayout>

            <TextView
                android:id="@+id/ozet_not"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/ozet_yenile"
                android:textSize="11sp"
                android:textColor="@color/kerteriz_accent"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Kılcal ayraç. Burada düz bir View KULLANILAMAZ: RemoteViews yalnızca
         @RemoteView işaretli sınıfları şişirebiliyor, android.view.View o listede
         değil ve widget eklenirken "eklenemedi" hatası veriyor.
         FrameLayout listede var, o yüzden ayraç bir FrameLayout. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="13dp"
        android:background="@color/kerteriz_line2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ozet_hazirlik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="@color/kerteriz_ink"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ozet_hazirlik_etiket"
                android:textSize="11sp"
                android:textColor="@color/kerteriz_ink3"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ozet_uyku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="@color/kerteriz_ink"/>
            <TextView
                android:id="@+id/ozet_uyku_etiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ozet_uyku_etiket"
                android:textSize="11sp"
                android:textColor="@color/kerteriz_ink3"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ozet_nabiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="@color/kerteriz_ink"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ozet_nabiz_etiket"
                android:textSize="11sp"
                android:textColor="@color/kerteriz_ink3"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
