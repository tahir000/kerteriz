<?xml version="1.0" encoding="utf-8"?>
<!-- Özet, büyük (4x3 ve üstü): halkalar, skorlar ve günün cümlesi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ozet_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/su_widget_zemin"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center">
        <ImageView
            android:id="@+id/ozet_halka"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/halka_onizleme_ozet"
            android:contentDescription="@string/ozet_halka_aciklama"/>

    </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="9sp"
                android:paddingEnd="6dp"
                android:textColor="@color/kerteriz_halka_dis"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/ozet_adim"
                android:textSize="12sp"
                android:maxLines="1"
                android:textColor="@color/kerteriz_ink2"/>
            <TextView
                android:id="@+id/ozet_adim_deger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="13sp"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/kerteriz_ink"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="9sp"
                android:paddingEnd="6dp"
                android:textColor="@color/kerteriz_halka_orta"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/ozet_kalori"
                android:textSize="12sp"
                android:maxLines="1"
                android:textColor="@color/kerteriz_ink2"/>
            <TextView
                android:id="@+id/ozet_kalori_deger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="13sp"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/kerteriz_ink"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="9sp"
                android:paddingEnd="6dp"
                android:textColor="@color/kerteriz_halka_ic"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/ozet_mesafe"
                android:textSize="12sp"
                android:maxLines="1"
                android:textColor="@color/kerteriz_ink2"/>
            <TextView
                android:id="@+id/ozet_mesafe_deger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="13sp"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/kerteriz_ink"/>
        </LinearLayout>
        <TextView
            android:id="@+id/ozet_not"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ozet_yenile"
            android:textSize="11sp"
            android:textColor="@color/kerteriz_accent"/>
        </LinearLayout>
    </LinearLayout>
    <!-- Ayraç FrameLayout: RemoteViews düz View şişiremiyor. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/kerteriz_line2"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ozet_hazirlik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="@color/kerteriz_ink"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ozet_hazirlik_etiket"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/kerteriz_ink3"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ozet_uyku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="@color/kerteriz_ink"/>
            <TextView
                android:id="@+id/ozet_uyku_etiket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ozet_uyku_etiket"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/kerteriz_ink3"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ozet_nabiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textColor="@color/kerteriz_ink"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ozet_nabiz_etiket"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/kerteriz_ink3"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/ozet_cumle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/kerteriz_ink2"/>
</LinearLayout>
