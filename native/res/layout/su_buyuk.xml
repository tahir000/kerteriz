<?xml version="1.0" encoding="utf-8"?>
<!-- Su, büyük (3x3 ve üstü): büyük halka, durum satırı ve düğme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/su_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/su_widget_zemin"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/su_baslik"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/kerteriz_ink2"/>
        <TextView
            android:id="@+id/su_geri_al"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:background="@drawable/kerteriz_dokunma"
            android:text="@string/su_geri_al"
            android:textSize="12sp"
            android:textColor="@color/kerteriz_accent"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <ImageView
            android:id="@+id/su_halka"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/halka_onizleme_su"
            android:scaleType="fitCenter"
            android:contentDescription="@string/su_halka_aciklama"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/su_toplam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/kerteriz_ink"/>
            <TextView
                android:id="@+id/su_hedef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="/ 2500 ml"
                android:textSize="12sp"
                android:textColor="@color/kerteriz_ink3"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/su_durum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="@color/kerteriz_ink2"/>
    <TextView
        android:id="@+id/su_buton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="+ 250 ml"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/kerteriz_buton_yazi"
        android:background="@drawable/su_buton"/>
</LinearLayout>
