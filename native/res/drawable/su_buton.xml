<?xml version="1.0" encoding="utf-8"?>
<!-- Su düğmesi: kapsül, basınca dalga. RemoteViews ripple arka planını
     destekliyor; widget'larda yapılabilen tek gerçek dokunma efekti bu. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kerteriz_dalga">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kerteriz_buton"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</ripple>
