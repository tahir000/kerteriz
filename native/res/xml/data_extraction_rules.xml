<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sağlık verisi buluta (Google Drive) yedeklenmez.
     Yeni telefona doğrudan aktarımda etiketler, hisler, regl işaretleri ve
     ayarlar taşınır; önbellek taşınmaz, Health Connect'ten yeniden okunur. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="kerteriz_onbellek.json" />
        <exclude domain="file" path="kerteriz_iz.log" />
        <exclude domain="file" path="kerteriz_iz_onceki.log" />
    </device-transfer>
</data-extraction-rules>
